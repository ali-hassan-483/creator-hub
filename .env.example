# Database
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/content_platform"

# NextAuth
NEXTAUTH_SECRET="your-secret-32-char-minimum-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Redis
REDIS_URL="redis://localhost:6379"

# Encryption key for credentials/VPS passwords (32 bytes hex = 64 chars)
ENCRYPTION_KEY="your-64-char-hex-encryption-key-here"

# Admin seed credentials (used only for initial setup)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Admin"
