        "supabaseApi": {
          "id": "mDcvIAvqzMOfJouq",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst ids = items.map(i => i.json.youtube_id).filter(Boolean);\nconst batches = [];\nfor (let i = 0; i < ids.length; i += 50) {\n  batches.push(ids.slice(i, i + 50));\n} \nreturn batches.map(b => ({ json: { ids: b.join(',') } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        144
      ],
      "id": "f76a999c-9dec-41f5-a456-4066eecfc7ee",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "url": "=https://www.googleapis.com/youtube/v3/videos?part=statistics&id={{ $json.ids }}&key=AIzaSyBEVjS3bDbfwjfCK1IBfzMWwiTTD0siYvg",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        704,
        144
      ],
      "id": "30ff4341-8bf5-476d-b472-61191aebb93d",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const campaigns = $('Get Campaigns').all();\nconst thresholdByCampaign = {};\nfor (const c of campaigns) {\n  thresholdByCampaign[c.json.name] = c.json.min_views;\n} \nconst statsById = {};\nfor (const batch of $input.all()) {\n  const items = batch.json.items || [];\n  for (const item of items) {\n    statsById[item.id] = Number(item.statistics.viewCount || 0);\n  }\n}\nconst videos = $('Get many rows').all();\nconst results = [];\nfor (const video of videos) {\n  const v = video.json;\n  const views = statsById[v.youtube_id];\n  if (views === undefined) continue;\n  const threshold = thresholdByCampaign[v.campaign] ?? Infinity;\n  const qualified = views >= threshold;\n  results.push({ json: { id: v.id, views, views_status: qualified ? 'qualified' : 'checking', review_status: qualified ? 'awaiting_requirements' : null, last_checked_at: new Date().toISOString(), } });\n} \nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -32
      ],
      "id": "eb1c9d72-5674-4d30-96d5-6e517bb0fb30",
