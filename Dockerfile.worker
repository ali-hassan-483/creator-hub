FROM node:20-slim
WORKDIR /app

# Install system dependencies + Python + pip + ffmpeg + yt-dlp + fonts
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    libssl3 \
    ffmpeg \
    python3 \
    python3-pip \
    python3-venv \
    yt-dlp \
    fontconfig \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# Install OpenAI Whisper (CPU-only PyTorch ~180MB, avoids 4.5GB of useless CUDA GPU bloat)
RUN pip3 install --no-cache-dir --break-system-packages torch --index-url https://download.pytorch.org/whl/cpu && \
    pip3 install --no-cache-dir --break-system-packages openai-whisper

COPY package.json ./
RUN npm install
COPY . .
RUN mkdir -p /usr/share/fonts/truetype/custom && \
    (cp /app/public/fonts/*.ttf /usr/share/fonts/truetype/custom/ 2>/dev/null || true) && \
    fc-cache -f

RUN npx prisma generate
ENTRYPOINT ["sh", "-c", "npx prisma generate && exec \"$@\"", "--"]
CMD ["echo", "specify command via docker-compose"]
